
DEPLOYMENT_VERSION=3.2.0

# Application Name
AppName=Five Safes TES

# Name of the deployed TRE
TreName=DEMO

# Env vars to be changed to escape simulation in DemoStack
SeedDemoData=true
UseTESK=true
KeyCloakDemoMode=true

# Demo Mode Password
DemoModePassword=password123

# Internal Postgres Superuser creds
PGLOGIN=admin
PGPASSWORD=admin

# Serilog Minimum Level
SerilogLevel=Information

# Encryption settings (Base-64 String) - Defaulted for development/demo purposes only - NEVER USE IN PRODUCTION
EncryptionSettingsKey=9pDUei4zHnuXrC0Hb0KSG0g1U4GsV6ajZf+/kYKtrI8=

# LDAP Credentials
LDAPAdminPassword=admin
LDAPConfigPassword=config

# Vault Credentials
VaultRootToken=dev-only-token
# Vault Startup Command (please make sure the dev-root-token-id below is the same as the VaultRootToken above)
VaultStartupCommand="vault server -dev -dev-root-token-id=dev-only-token"

# Keycloak Credentials
KeycloakBootstrapAdminPassword=admin
# Keycloak Startup Command
KeycloakStartupCommand=start-dev

# RabbitMQ Credentials
RabbitMQDefaultPassword=guest

# TRE Data DB Credentials
# Used for the TRE Agent to create temporary credentials against any Postgres database:
TRE_DATA_SERVER=postgres
TRE_DATA_PORT=5432
TRE_DATA_DATABASE=tredata
TRE_DATA_USER=admin
TRE_DATA_PASSWORD=admin

# Public URL of the TRE API
TreApiPublicUrl=http://localhost:8072

# Submision API URL
SubmissionAPIAddressURL=http://submissionAPI:8080

# Local Keycloak full URL Host name
KeycloakFullURL=http://keycloak.localtest.me:8085
# TRE KeyCloak URL
TRE_KEYCLOAK_URL=http://keycloak.localtest.me:8085
# Submission KeyCloak URL
SUBMISSION_KEYCLOAK_URL=http://keycloak.localtest.me:8085

## Submission S3 Settings
# Submission S3 API URL
SubmissionS3ApiUrl=http://rustfs_submission:9000
# Submission S3 Console URL
SubmissionS3ConsoleUrl=http://localhost:9001
# Submission S3 OpenID Secret
SubmissionS3OpenidSecret=8a11bbcd-693a-4549-bda4-3e978fcf4de1
# Submission S3 Root User and Password
SubmissionS3RootUser=s3-submission
SubmissionS3RootPass=s3-submission-pass


## TRE S3 Settings
# TRE S3 Console URL
TRES3ConsoleUrl=http://localhost:9003
# TRE S3 OpenID Secret
TRES3OpenidSecret=71ee3de3-0e0c-49c8-a0b2-c0e490c90591
# TRE S3 Root User and Password
TRES3RootUser=s3-tre
TRES3RootPass=s3-tre-pass

# Where TESK or Funnel API is hosted:
TesAPIUrl=http://host.docker.internal:8000/v1/tasks
# Output bucket prefix for the TES executing agent to write results to
TesOutputBucketPrefix=s3://

# Docker Funnel Settings
# TesAPIUrl=http://funnel:8000/v1/tasks
# FunnelS3User=S3funnel
# FunnelS3Pass=S3funnel

# Sync Settings:
# Sync Projects & Users between TRE & Submission Layer - default every 10 minutes
syncSchedule=2
# Scan Submission Layer for available submissions - default every 1 minute
scanSchedule=1
# The frequency at which the health check runs
healthCheckSchedule=1
# The length of time a health check log is kept in the database before it gets deleted - default 30 days
daysBeforeHealthLogDeletion=30
# Hangfire settings
HangfireUser=admin
HangfirePassword=password

# Egress Keycloak Settings:
EgressKeyCloakClientUIRedirectURL=http://localhost:8100
EgressKeyCloakSecret=81c1f071-8c45-49ef-a966-84ca8f420b7e

# TRE UI Keycloak Settings:
TreKeyCloakClientUIRedirectURL=http://localhost:8989
TreKeyCloakSecret=2de114bc-3599-45f1-9b61-5090c6859dfe

# TRE API Keycloak Settings:
TreAPIKeyCloakClientUIRedirectURL=http://localhost.me:8989
TreAPIKeyCloakSecret=e9021a57-3f4f-4254-ba27-2cdbb99a2cb5

# Submission UI Keycloak Settings:
SubmissionKeyCloakClientUIRedirectURL=http://localhost:7220
SubmissionUIClientSecret=1218304e-bf92-4706-83f6-912e0b04ecb9

# Submission API Keycloak Settings - used to authorise TRE API against Submission API:
SubmissionAPIKeyCloakClientUIRedirectURL=http://localhost:8989
SubmissionAPIKeyCloakSecret=2e60b956-16bc-4dea-8b49-118a8baac5e5

# Server URL for Submission Keycloak
SubmissionKeyCloakServer=keycloak:8080
# Protocol for Submission Keycloak
SubmissionServerProtocol=http

# Default SQL Query Image to run in the SQL wizard
URLSettingsFrontEndQueryImageSQL=harbor.federated-analytics.ac.uk/5s-tes-analysis-tools/5s-tes-analysis-tools-tre-sqlpg:1.0.0

# Secret for Better Auth - Defaulted for development/demo purposes only - NEVER USE IN PRODUCTION
BETTER_AUTH_SECRET=r6oTUwEUlvoa4Fdh3XIBviHRVpCudrt3
# URL of the Better Auth server
BETTER_AUTH_URL=http://localhost:3000

# If having issues with keycloak set this to false
sslcookies=false
# If http only site set this to false
httpsRedirect=false
# Proxy Settings (to be reviewed and removed if not needed):
http_proxy=http://192.168.10.15:8080
https_proxy=http://192.168.10.15:8080
useproxy=false
proxyurl=http://192.168.10.15:8080
# Submission Keycloak settings (to be reviewed and removed if not needed):
SubmissionTokenRefreshSeconds=3600
SubmissionSignedOutRedirectUri=/
SubmissionAutoTrustKeycloakCert=false
SubmissionValidIssuer=
SubmissionValidAudience=
SuppressAntiforgery=false

# Agent deploy / service-account settings
SubmissionApiUrl=http://submissionAPI:8080
KeycloakAdmin__Username=dare-control-realm-user
KeycloakAdmin__Password=password123

# Config path for infrastructure services (Keycloak, Ldap, Ldap Init, Postgres, Realm Configuration, Vault)
CONFIG_PATH=../../../DemoStack/config